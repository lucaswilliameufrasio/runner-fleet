#!/bin/sh
# Run as root after reviewing this script and lab-firewall-inspect.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
if [ "$(id -u)" -ne 0 ] || [ "$#" -ne 1 ]; then
    echo "Usage: run as root: $0 USER" >&2
    exit 2
fi
user=$1
case "$user" in
    ''|*[!a-z0-9_-]*|-*|[0-9]*)
        echo "Invalid local username." >&2
        exit 2
        ;;
esac
if ! id "$user" >/dev/null 2>&1 || [ "$(id -u "$user")" -eq 0 ]; then
    echo "User must exist and must not be root." >&2
    exit 2
fi
helper=/usr/local/sbin/runner-fleet-lab-firewall-inspect
rule=/etc/sudoers.d/runner-fleet-lab-inspect
source_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -e "$helper" ] || [ -L "$helper" ] || [ -e "$rule" ] || [ -L "$rule" ]; then
    echo "Existing lab files detected; refusing to overwrite." >&2
    exit 1
fi
if [ ! -f "$source_dir/lab-firewall-inspect" ] || [ -L "$source_dir/lab-firewall-inspect" ]; then
    echo "Missing regular helper source." >&2
    exit 1
fi
tmp=$(mktemp /etc/sudoers.d/.runner-fleet-lab-inspect.XXXXXXXX)
installed=0
cleanup() {
    rm -f -- "$tmp"
    if [ "$installed" -eq 1 ]; then
        rm -f -- "$helper"
    fi
}
trap cleanup EXIT HUP INT TERM
printf '%s ALL=(root) NOPASSWD: %s ""\n' "$user" "$helper" > "$tmp"
chmod 440 "$tmp"
visudo -cf "$tmp"
install -o root -g root -m 755 "$source_dir/lab-firewall-inspect" "$helper"
installed=1
mv -T -- "$tmp" "$rule"
installed=0
echo "Installed read-only firewall inspection for $user."
